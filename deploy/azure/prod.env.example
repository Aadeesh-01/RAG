# Production settings for deploy/azure/deploy.ps1 / deploy.sh.
#   cp deploy/azure/prod.env.example deploy/azure/prod.env     # prod.env is git- and docker-ignored
# KEY=value lines, no quotes needed, no spaces around "=". The deploy scripts store the
# secrets as Container Apps secrets and never print them. Everything else
# (CODERAG_PUBLIC_URL, CODERAG_TRUSTED_PROXY_HOPS=1, CODERAG_DATA_DIR=/data, ...) is set by
# the scripts.

# ── secrets ──────────────────────────────────────────────────────────────────
# Two different random values, each from:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CODERAG_SESSION_SECRET=
CODERAG_TOKEN_KEY=
# The GitHub OAuth app (github.com/settings/developers). Its callback URL is printed by deploy.
CODERAG_GITHUB_CLIENT_SECRET=
# Neon: the direct (non-pooler) connection string, postgresql://...?sslmode=require
CODERAG_DATABASE_URL=
# The server's LLM key (Groq)
GROQ_API_KEY=

# ── not secret ───────────────────────────────────────────────────────────────
CODERAG_GITHUB_CLIENT_ID=
