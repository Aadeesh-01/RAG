# Run the image locally with SQLite (no GitHub sign-in, no Neon):
#   cp deploy/local.env.example deploy/local.env     # local.env is git- and docker-ignored
#   docker run --rm -p 7860:7860 --env-file deploy/local.env coderag
# The server key is optional: without it, answers need the visitor's own key (sources still work).
CODERAG_PUBLIC_URL=http://localhost:7860
CODERAG_DATA_DIR=/data
# GROQ_API_KEY=gsk_...
